# ---- Postgres ----
POSTGRES_USER=burtsev
POSTGRES_PASSWORD=burtsev
POSTGRES_DB=burtsev
POSTGRES_PORT=5432

# ---- Backend (NestJS) ----
# For local (host) runs point at localhost; docker-compose overrides host to "postgres".
DATABASE_URL=postgresql://burtsev:burtsev@localhost:5432/burtsev?schema=public
BACKEND_PORT=4000
# Comma-separated list of allowed CORS origins for the GraphQL API.
CORS_ORIGIN=http://localhost:5173

# ---- Frontend (Vite) ----
# Base URL of the GraphQL endpoint the browser talks to.
VITE_GRAPHQL_URL=http://localhost:4000/graphql
FRONTEND_PORT=5173
