# ---- Frontend (Vite) ----
# Базовый URL GraphQL-эндпоинта, к которому обращается браузер.
# ВАЖНО: значение инлайнится в бандл на этапе сборки — меняешь его -> нужен пересбор (Redeploy).
# Локально: http://localhost:4000/graphql
# Прод: https://<домен-бэкенда>/graphql
VITE_GRAPHQL_URL=http://localhost:4000/graphql
