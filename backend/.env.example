# ---- Backend (NestJS + Prisma) ----

# Строка подключения к Postgres (обязательно — использует Prisma).
# Локальный запуск (backend на хосте): host = localhost.
# В docker-compose это значение переопределяется, host = postgres.
DATABASE_URL=postgresql://burtsev:burtsev@localhost:5432/burtsev?schema=public

# Порт HTTP-сервера. В проде платформа может задать PORT — он имеет приоритет.
BACKEND_PORT=4000

# Список разрешённых CORS-origin через запятую (фронтенд).
CORS_ORIGIN=http://localhost:5173

# Засев контента при старте. Поставь false в проде, когда контент уже залит.
SEED_ON_BOOT=true
